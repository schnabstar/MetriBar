            "state": "translated",
            "value": "Server verlangt ein Passwort"
          }
        }
      }
    },
    "Server selected in the menu": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Menü ausgewählter Server"
          }
        }
      }
    },
    "Server settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Servereinstellungen"
          }
        }
      }
    },
    "Servers": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        }
      }
    },
    "Showing values from %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angezeigte Werte: %@."
          }
        }
      }
    },
    "Something answers at this URL, but it is not Glances 5. Check the address and port; Glances uses port 61208 by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dieser URL antwortet etwas, aber nicht Glances 5. Prüfe Adresse und Port; Glances verwendet standardmäßig Port 61208."
          }
        }
      }
    },
    "Source Code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quellcode"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        }
      }
    },
    "Status icon and CPU usage": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statussymbol und CPU-Auslastung"
          }
        }
      }
    },
    "Status icon and memory usage": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statussymbol und Speicherauslastung"
          }
        }
      }
    },
    "Status icon only": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Statussymbol"
          }
        }
      }
    },
    "Stop Trusting": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht mehr vertrauen"
          }
        }
      }
    },
    "Switch server": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server wechseln"
          }
        }
      }
    },
    "Test Connection": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung testen"
          }
        }
      }
    },
    "The Keychain reported error %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüsselbund meldet den Fehler %lld."
          }
        }
      }
    },
    "The URL is not valid.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die URL ist ungültig."
          }
        }
      }
    },
    "The URL needs a host name or IP address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die URL braucht einen Hostnamen oder eine IP-Adresse."
          }
        }
      }
    },
    "The address of Glances 5 running as a web server (glances -s), including the port.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse von Glances 5 im Webserver-Modus (glances -s), einschließlich Port."
          }
        }
      }
    },
    "The answer could not be read. Glances 5 is still in beta; please report this together with the diagnostic details.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort konnte nicht gelesen werden. Glances 5 ist noch eine Beta – bitte melde das zusammen mit den Diagnosedetails."
          }
        }
      }
    },
    "The certificate is self-signed, expired or issued for another name. You can check it and trust it in the server settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zertifikat ist selbstsigniert, abgelaufen oder für einen anderen Namen ausgestellt. Du kannst es in den Servereinstellungen prüfen und ihm vertrauen."
          }
        }
      }
    },
    "The containers plugin is not active on this server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Container-Plugin ist auf diesem Server nicht aktiv."
          }
        }
      }
    },
    "The encrypted connection could not be established. Does the server use HTTPS on this port? For plain HTTP, start the URL with http://.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verschlüsselte Verbindung kam nicht zustande. Verwendet der Server auf diesem Port HTTPS? Für unverschlüsseltes HTTP beginne die URL mit http://."
          }
        }
      }
    },
    "The host name could not be resolved. Check the URL and, if you use one, the VPN connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hostname konnte nicht aufgelöst werden. Prüfe die URL und gegebenenfalls die VPN-Verbindung."
          }
        }
      }
    },
    "The icon always shows the state of all servers: a warning or error on any server changes its shape.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Symbol zeigt immer den Zustand aller Server: Eine Warnung oder ein Fehler auf einem Server ändert seine Form."
          }
        }
      }
    },
    "The password is sent unencrypted and can be read by others on the network. Use HTTPS, for example with a reverse proxy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort wird unverschlüsselt übertragen und kann im Netzwerk mitgelesen werden. Verwende HTTPS, zum Beispiel über einen Reverse Proxy."
          }
        }
      }
    },
    "The saved password could not be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gespeicherte Passwort konnte nicht gelesen werden."
          }
        }
      }
    },
    "The server answered with HTTP status %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server antwortete mit HTTP-Status %lld."
          }
        }
      }
    },
    "The server did not answer in time. Check that it is running and reachable from this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat nicht rechtzeitig geantwortet. Prüfe, ob er läuft und von diesem Mac aus erreichbar ist."
          }
        }
      }
    },
    "The server presented a different certificate than the one you trusted. If you renewed it, trust the new certificate in the server settings. Otherwise someone may be intercepting the connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server zeigt ein anderes Zertifikat als das, dem du vertraut hast. Wenn du es erneuert hast, vertraue dem neuen Zertifikat in den Servereinstellungen. Andernfalls könnte jemand die Verbindung abfangen."
          }
        }
      }
    },
    "The server rejected the user name or password. MetriBar stops trying until you change them, so you are not locked out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat Benutzername oder Passwort abgelehnt. MetriBar versucht es erst wieder, wenn du sie änderst, damit du nicht gesperrt wirst."
          }
        }
      }
    },
    "The server runs Glances %@. This version of MetriBar supports Glances 5.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Server läuft Glances %@. Diese Version von MetriBar unterstützt Glances 5."
          }
        }
      }
    },
    "This Mac is not connected to a network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac ist mit keinem Netzwerk verbunden."
          }
        }
      }
    },
    "This build of MetriBar cannot use the Keychain. See the build instructions in the README.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build von MetriBar kann den Schlüsselbund nicht verwenden. Siehe die Bauanleitung im README."
          }
        }
      }
    },
    "This is not a valid URL.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine gültige URL."
          }
        }
      }
    },
    "This server requires a password. Add the user name and password in the server settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server verlangt ein Passwort. Trage Benutzername und Passwort in den Servereinstellungen ein."
          }
        }
      }
    },
    "Too many attempts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche"
          }
        }
